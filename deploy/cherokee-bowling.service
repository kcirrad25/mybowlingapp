[Unit]
Description=Cherokee Bowling League - Django/Gunicorn
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/cherokeebowling
EnvironmentFile=/home/ec2-user/cherokeebowling/.env
ExecStart=/home/ec2-user/cherokeebowling/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile /home/ec2-user/cherokeebowling/logs/access.log \
    --error-logfile /home/ec2-user/cherokeebowling/logs/error.log \
    --log-level info \
    config.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
