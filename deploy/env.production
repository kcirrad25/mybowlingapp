# ============================================================
# Cherokee Bowling League - PRODUCTION environment variables
# Copy this file to /home/ec2-user/cherokeebowling/.env
# and fill in every value marked REPLACE_ME
# ============================================================

# Django secret key - generate one at: https://djecrety.ir/
SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Must be False in production
DEBUG=False

# Your EC2 public IP, AND your domain name if you have one
# Example: ALLOWED_HOSTS=54.23.187.45,cherokeebowling.com,www.cherokeebowling.com
ALLOWED_HOSTS=REPLACE_ME_WITH_YOUR_EC2_IP

# Same as ALLOWED_HOSTS but with https:// prefix (used for forms/security)
# Example: CSRF_TRUSTED_ORIGINS=http://54.23.187.45
CSRF_TRUSTED_ORIGINS=http://REPLACE_ME_WITH_YOUR_EC2_IP

# Database - leave as-is to use SQLite (stored on the EC2 server)
# To switch to RDS later, replace with:
# DATABASE_URL=postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/DBNAME
DATABASE_URL=sqlite:////home/ec2-user/cherokeebowling/db.sqlite3

# S3 bucket for file uploads (logos, PDFs, score sheets)
# Leave blank to store files on the EC2 server instead
AWS_STORAGE_BUCKET_NAME=REPLACE_ME_WITH_YOUR_BUCKET_NAME
AWS_S3_REGION_NAME=REPLACE_ME_WITH_YOUR_REGION
# e.g. us-east-1

# Leave these blank - EC2 IAM role provides access automatically
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Static/media file locations inside the S3 bucket
AWS_LOCATION_STATIC=static
AWS_LOCATION_MEDIA=media
AWS_S3_CUSTOM_DOMAIN=

# IP addresses allowed to access /admin (your home/office/VPN IP)
# Find your IP at: https://whatismyip.com
# Leave blank to allow admin from anywhere (less secure)
ADMIN_ALLOWED_IPS=REPLACE_ME_WITH_YOUR_HOME_IP

# Set True only if behind a load balancer (not needed for basic EC2)
TRUST_X_FORWARDED_FOR=False

# Name shown in authenticator apps for admin MFA
OTP_TOTP_ISSUER=Cherokee Bowling League

# Leave False until you specifically want to enable OCR for scanned PDFs
AWS_TEXTRACT_ENABLED=False
AWS_TEXTRACT_SNS_TOPIC_ARN=
AWS_TEXTRACT_ROLE_ARN=
